# Copy this file to `.env.local` and paste your own key to enable
# AI-assisted product parsing + ingredient analysis.
#
# Get a free key at https://aistudio.google.com/apikey
#
# Without a key, Bloom still runs fully offline using the on-device
# watchlist (unknown products default conservatively to "Check").

GEMINI_API_KEY=your-gemini-api-key-here
